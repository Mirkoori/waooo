{
  "expo": {
    "name": "WAOOO",
    "slug": "waooo",
    "scheme": "waooo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ECE9E3",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ECE9E3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.waooo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "WAOOO lets you add Fashion Week events to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "WAOOO lets you add Fashion Week events to your calendar.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "WAOOO lets you add Fashion Week events to your calendar."
      }
    },
    "android": {
      "package": "com.waooo.app",
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-calendar"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/waooo"
    },
    "description": "WAOOO — Milan Fashion Week, unlocked. Calendar of fashion weeks, runway shows, presentations, events, trade shows, showrooms, brands and stores."
  }
}
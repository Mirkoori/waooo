{
  "expo": {
    "name": "WAOOO",
    "slug": "waooo",
    "scheme": "waooo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ECE9E3",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ECE9E3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.waooo.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "WAOOO adds Fashion Week events to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "WAOOO adds Fashion Week events to your calendar."
      }
    },
    "android": {
      "package": "com.waooo.app",
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "WAOOO adds Fashion Week events to your calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}